@page "/"
@using System.Text
@inject IJSRuntime JS

<PageTitle>Vega: gerador de instalação do Windows</PageTitle>

<header class="topo">
    <a class="marca" href=".">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 1.5c.7 6.1 4.4 9.8 10.5 10.5-6.1.7-9.8 4.4-10.5 10.5C11.3 16.4 7.6 12.7 1.5 12 7.6 11.3 11.3 7.6 12 1.5Z" fill="currentColor" /></svg>
        <strong>Vega</strong>
    </a>
    <div class="topo-acoes">
        <button type="button" class="botao-leve" @onclick="AlternarTema">@(temaAtual == "claro" ? "Tema grafite" : "Tema claro")</button>
        <a class="botao-leve" href="https://github.com/erickfuzer/Vega" target="_blank" rel="noopener">GitHub</a>
    </div>
</header>

<section class="intro">
    <h1>Monte a sua instalação do Windows, sem perder tempo com o que não usa.</h1>
    <p>Escolha o que fica e o que sai, e baixe um <code>autounattend.xml</code> pronto. Tudo roda no seu navegador: nada do que você marca sai do seu computador.</p>
    <div class="perfis" role="group" aria-label="Perfis prontos">
        @foreach (var perfil in Perfis.Todos)
        {
            <button type="button" class="perfil @(perfilAtivo == perfil.Id ? "ativo" : "")" aria-pressed="@(perfilAtivo == perfil.Id ? "true" : "false")" @onclick="() => AplicarPerfil(perfil)">
                <strong>@perfil.Nome</strong>
                <span>@perfil.Descricao</span>
            </button>
        }
    </div>
</section>

@if (erro is not null)
{
    <p class="aviso-erro" role="alert">@erro</p>
}

<div class="corpo">
    <aside class="lateral">
        <input class="busca" type="search" placeholder="Buscar opção" aria-label="Buscar opção" @bind="busca" @bind:event="oninput" />
        <nav class="categorias" aria-label="Categorias">
            @foreach (var categoria in Enum.GetValues<Categoria>())
            {
                var total = ContarAlteracoes(categoria);
                <button type="button" class="categoria @(!Buscando && categoriaAtual == categoria ? "ativa" : "")" @onclick="() => SelecionarCategoria(categoria)">
                    @Catalogo.NomesCategorias[categoria]
                    @if (total > 0)
                    {
                        <span class="contador">@total</span>
                    }
                </button>
            }
        </nav>
    </aside>

    <main class="conteudo">
        @if (Buscando)
        {
            <h2>Resultados</h2>
            var opcoes = Catalogo.Opcoes.Where(o => Combina(o.Titulo) || Combina(o.Descricao)).ToList();
            var apps = Catalogo.Apps.Where(a => Combina(a.Nome) || Combina(a.Grupo)).ToList();
            var opcoesScript = Catalogo.OpcoesScript.Where(o => Combina(o.Titulo) || Combina(o.Descricao)).ToList();
            @if (opcoes.Count == 0 && apps.Count == 0 && opcoesScript.Count == 0)
            {
                <p class="vazio">Nada encontrado para "@busca".</p>
            }
            @if (opcoesScript.Count > 0)
            {
                <h3 class="resultado-categoria">Modo script</h3>
                <div class="lista">
                    @foreach (var opcao in opcoesScript)
                    {
                        @LinhaOpcaoScript(opcao)
                    }
                </div>
            }
            @foreach (var grupo in opcoes.GroupBy(o => o.Categoria))
            {
                <h3 class="resultado-categoria">@Catalogo.NomesCategorias[grupo.Key]</h3>
                <div class="lista">
                    @foreach (var opcao in grupo)
                    {
                        @LinhaOpcao(opcao)
                    }
                </div>
            }
            @if (apps.Count > 0)
            {
                <h3 class="resultado-categoria">Apps e recursos</h3>
                <div class="lista">
                    @foreach (var app in apps)
                    {
                        @LinhaApp(app)
                    }
                </div>
            }
        }
        else
        {
            <h2>@Catalogo.NomesCategorias[categoriaAtual]</h2>
            @switch (categoriaAtual)
            {
                case Categoria.Instalacao:
                    <p class="secao-sub">Idioma, região e edição usados pela instalação.</p>
                    <div class="lista">
                        <label class="opcao @(estado.EscolherIdiomaNaInstalacao ? "ligada" : "")">
                            <span class="opcao-titulo">Escolher o idioma na hora de instalar</span>
                            <span class="opcao-descricao">A instalação pergunta idioma e teclado, em vez de usar os valores abaixo.</span>
                            <input class="chave" type="checkbox" role="switch" @bind="estado.EscolherIdiomaNaInstalacao" />
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Idioma do Windows</span>
                            <span class="campo-descricao">Precisa ser um idioma que exista na sua ISO.</span>
                            <select @bind="estado.IdiomaImagem" disabled="@estado.EscolherIdiomaNaInstalacao">
                                @foreach (var item in Gerador.ImageLanguages.Values.OrderBy(i => i.DisplayName))
                                {
                                    <option value="@item.Id">@item.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Formato regional</span>
                            <span class="campo-descricao">Datas, moeda e números.</span>
                            <select @bind="estado.IdiomaRegional" disabled="@estado.EscolherIdiomaNaInstalacao">
                                @foreach (var item in Gerador.UserLocales.Values.OrderBy(i => i.DisplayName))
                                {
                                    <option value="@item.Id">@item.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Teclado</span>
                            <span class="campo-descricao">O padrão é o ABNT2 brasileiro.</span>
                            <select @bind="estado.Teclado" disabled="@estado.EscolherIdiomaNaInstalacao">
                                @foreach (var item in Gerador.KeyboardIdentifiers.Values.OrderBy(i => i.DisplayName))
                                {
                                    <option value="@item.Id">@item.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">País ou região</span>
                            <span class="campo-descricao">Define conteúdos e serviços regionais.</span>
                            <select @bind="estado.Regiao" disabled="@estado.EscolherIdiomaNaInstalacao">
                                @foreach (var item in Gerador.GeoLocations.Values.OrderBy(i => i.DisplayName))
                                {
                                    <option value="@item.Id">@item.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Edição do Windows</span>
                            <span class="campo-descricao">Precisa bater com a licença da máquina para ativar sozinha.</span>
                            <select @bind="estado.Edicao">
                                <option value="">Perguntar na instalação</option>
                                @foreach (var item in Gerador.WindowsEditions.Values.Where(e => e.Visible).OrderBy(i => i.DisplayName))
                                {
                                    <option value="@item.Id">@item.DisplayName</option>
                                }
                            </select>
                        </label>
                        <label class="opcao @(estado.IgnorarRequisitos && estado.Modo == ModoInstalacao.TelaNormal ? "ligada" : "") @(estado.Modo != ModoInstalacao.TelaNormal ? "desativada" : "")">
                            <span class="opcao-titulo">Ignorar os requisitos do Windows 11</span>
                            <span class="opcao-descricao">Permite instalar sem TPM, Secure Boot ou processador da lista oficial. No modo script, a verificação não acontece.</span>
                            <input class="chave" type="checkbox" role="switch" disabled="@(estado.Modo != ModoInstalacao.TelaNormal)" @bind="estado.IgnorarRequisitos" />
                        </label>
                        @ListaOpcoes(Categoria.Instalacao)
                    </div>
                    break;

                case Categoria.Disco:
                    <p class="secao-sub">Como o Windows chega ao disco. Esta é a parte da instalação que pode apagar seus arquivos.</p>
                    <div class="lista">
                        <label class="campo">
                            <span class="campo-titulo">Modo de instalação</span>
                            <span class="campo-descricao">O modo normal usa a tela de discos do Windows. O modo script libera as opções abaixo e o desligamento do Defender.</span>
                            <select @bind="estado.Modo" @bind:after="MarcarPersonalizado">
                                <option value="@ModoInstalacao.TelaNormal">Normal, escolhendo o disco na tela do Windows</option>
                                <option value="@ModoInstalacao.Script">Script do Vega</option>
                                <option value="@ModoInstalacao.ScriptProprio">Meu próprio script</option>
                            </select>
                        </label>
                    </div>

                    @if (estado.Modo == ModoInstalacao.TelaNormal)
                    {
                        <p class="alerta">Nada é apagado sem você escolher na tela do Windows. Este é o modo mais seguro.</p>
                        <div class="lista">
                            <label class="opcao @(estado.UsarConfigurationSet ? "ligada" : "")">
                                <span class="opcao-titulo">Usar um conjunto de configuração</span>
                                <span class="opcao-descricao">Para quem tem uma pasta $OEM$ na mídia e quer que a instalação do Windows a copie.</span>
                                <input class="chave" type="checkbox" role="switch" @bind="estado.UsarConfigurationSet" @bind:after="MarcarPersonalizado" />
                            </label>
                        </div>
                    }
                    else if (estado.Modo == ModoInstalacao.ScriptProprio)
                    {
                        <p class="alerta risco" role="alert">Seu script substitui toda essa etapa da instalação e pode apagar qualquer disco. O Vega não confere o que ele faz.</p>
                        <label class="campo campo-texto">
                            <span class="campo-titulo">Script do WinPE (.cmd)</span>
                            <span class="campo-descricao">Lembre que o ambiente de instalação não tem findstr e outros comandos comuns.</span>
                            <textarea rows="10" spellcheck="false" @bind="estado.ScriptInstalacao" @bind:after="MarcarPersonalizado"></textarea>
                        </label>
                    }
                    else
                    {
                        @if (estado.ApagaSemPerguntar)
                        {
                            <p class="alerta risco" role="alert"><strong>O disco será apagado sem nenhuma pergunta.</strong> Basta dar boot com esse pendrive em qualquer computador. Ligue a pausa antes de formatar, a menos que tenha certeza.</p>
                        }
                        else if (estado.ApagaDisco)
                        {
                            <p class="alerta risco" role="alert"><strong>Este modo apaga o disco inteiro</strong>, sem escolher partições. Confira o disco na hora pelo tamanho, porque o pendrive também pode aparecer na lista, e o número dos discos pode mudar.</p>
                        }

                        <h3 class="grupo-titulo">Disco</h3>
                        <div class="lista">
                            <label class="campo">
                                <span class="campo-titulo">Particionamento</span>
                                <span class="campo-descricao">À mão, você abre um console com Shift + F10 e usa o diskpart.</span>
                                <select @bind="estado.Particoes" @bind:after="MarcarPersonalizado">
                                    <option value="@Particionamento.ApagarDisco">Apagar o disco inteiro e recriar</option>
                                    <option value="@Particionamento.AMao">Particionar à mão</option>
                                    <option value="@Particionamento.ScriptDiskpart">Meu script do diskpart</option>
                                </select>
                            </label>

                            @if (estado.Particoes == Particionamento.ScriptDiskpart)
                            {
                                <label class="campo campo-texto">
                                    <span class="campo-titulo">Script do diskpart</span>
                                    <span class="campo-descricao">Precisa ter ASSIGN LETTER=W para o Windows e ASSIGN LETTER=S para o sistema.</span>
                                    <textarea rows="8" spellcheck="false" @bind="estado.ScriptDiskpart" @bind:after="MarcarPersonalizado"></textarea>
                                </label>
                            }

                            @if (estado.Particoes == Particionamento.ApagarDisco)
                            {
                                <label class="campo">
                                    <span class="campo-titulo">Qual disco</span>
                                    <span class="campo-descricao">Perguntar é o mais seguro. Os outros modos não pedem confirmação do disco.</span>
                                    <select @bind="estado.Alvo" @bind:after="MarcarPersonalizado">
                                        <option value="@AlvoDisco.Perguntar">Perguntar na hora</option>
                                        <option value="@AlvoDisco.Criterios">Encontrar por critérios</option>
                                        <option value="@AlvoDisco.Numero">Sempre o mesmo número</option>
                                        <option value="@AlvoDisco.ScriptProprio">Meu script</option>
                                    </select>
                                </label>

                                @if (estado.Alvo == AlvoDisco.Numero)
                                {
                                    <label class="campo">
                                        <span class="campo-titulo">Número do disco</span>
                                        <span class="campo-descricao">O número pode mudar com o pendrive conectado.</span>
                                        <input type="number" min="0" @bind="estado.DiscoNumero" @bind:after="MarcarPersonalizado" />
                                    </label>
                                }
                                else if (estado.Alvo == AlvoDisco.ScriptProprio)
                                {
                                    <label class="campo campo-texto">
                                        <span class="campo-titulo">Script que escolhe o disco (VBScript)</span>
                                        <span class="campo-descricao">Deve escrever o número do disco com WScript.Echo.</span>
                                        <textarea rows="6" spellcheck="false" @bind="estado.ScriptAlvoDisco" @bind:after="MarcarPersonalizado"></textarea>
                                    </label>
                                }
                                else if (estado.Alvo == AlvoDisco.Criterios)
                                {
                                    <p class="secao-sub">A instalação para com erro se nenhum disco, ou mais de um, passar nos critérios.</p>
                                    <label class="campo">
                                        <span class="campo-titulo">Tamanho mínimo (GiB)</span>
                                        <span class="campo-descricao">Vazio não aplica esse critério.</span>
                                        <input type="number" min="0" @bind="estado.CriterioMinimoGiB" @bind:after="MarcarPersonalizado" />
                                    </label>
                                    <label class="campo">
                                        <span class="campo-titulo">Tamanho máximo (GiB)</span>
                                        <span class="campo-descricao">Vazio não aplica esse critério.</span>
                                        <input type="number" min="0" @bind="estado.CriterioMaximoGiB" @bind:after="MarcarPersonalizado" />
                                    </label>
                                    <label class="campo">
                                        <span class="campo-titulo">Número do disco</span>
                                        <span class="campo-descricao">Vazio aceita qualquer número.</span>
                                        <input type="number" min="0" @bind="estado.CriterioNumero" @bind:after="MarcarPersonalizado" />
                                    </label>
                                    <label class="opcao @(estado.CriterioSemParticoes ? "ligada" : "")">
                                        <span class="opcao-titulo">Só aceitar disco sem partições</span>
                                        <span class="opcao-descricao">Protege um disco que já tem dados, mas a instalação para com erro se o disco alvo tiver partições.</span>
                                        @if (!estado.CriterioSemParticoes)
                                        {
                                            <span class="opcao-custo risco">Um disco com arquivos pode ser apagado se passar nos outros critérios.</span>
                                        }
                                        <input class="chave" type="checkbox" role="switch" @bind="estado.CriterioSemParticoes" @bind:after="MarcarPersonalizado" />
                                    </label>
                                    <label class="opcao @(estado.CriterioTipoInterno ? "ligada" : "")">
                                        <span class="opcao-titulo">Só aceitar disco interno</span>
                                        <span class="opcao-descricao">Recusa o que não for SATA ou NVMe, como pendrives.</span>
                                        <input class="chave" type="checkbox" role="switch" @bind="estado.CriterioTipoInterno" @bind:after="MarcarPersonalizado" />
                                    </label>
                                    <label class="opcao @(estado.CriterioMidiaFixa ? "ligada" : "")">
                                        <span class="opcao-titulo">Só aceitar mídia fixa</span>
                                        <span class="opcao-descricao">Recusa mídias removíveis.</span>
                                        <input class="chave" type="checkbox" role="switch" @bind="estado.CriterioMidiaFixa" @bind:after="MarcarPersonalizado" />
                                    </label>
                                }

                                <label class="campo">
                                    <span class="campo-titulo">Formato das partições</span>
                                    <span class="campo-descricao">Automático usa GPT em UEFI e MBR em BIOS.</span>
                                    <select @bind="estado.Layout" @bind:after="MarcarPersonalizado">
                                        <option value="@PartitionLayout.Automatic">Automático</option>
                                        <option value="@PartitionLayout.GPT">GPT</option>
                                        <option value="@PartitionLayout.MBR">MBR</option>
                                    </select>
                                </label>
                                <label class="campo">
                                    <span class="campo-titulo">Recuperação (WinRE)</span>
                                    <span class="campo-descricao">Sem ela, não há reparo de inicialização nem "Redefinir este PC".</span>
                                    <select @bind="estado.Recuperacao" @bind:after="MarcarPersonalizado">
                                        <option value="@RecoveryMode.Partition">Manter, em uma partição própria</option>
                                        <option value="@RecoveryMode.None">Apagar</option>
                                    </select>
                                </label>
                                <label class="campo">
                                    <span class="campo-titulo">Partição do sistema (MiB)</span>
                                    <span class="campo-descricao">O padrão é @Constants.SystemPartitionSize MiB.</span>
                                    <input type="number" min="100" @bind="estado.TamanhoSistemaMiB" @bind:after="MarcarPersonalizado" />
                                </label>
                                @if (estado.Recuperacao == RecoveryMode.Partition)
                                {
                                    <label class="campo">
                                        <span class="campo-titulo">Partição de recuperação (MiB)</span>
                                        <span class="campo-descricao">O padrão é @Constants.RecoveryPartitionSize MiB.</span>
                                        <input type="number" min="300" @bind="estado.TamanhoRecuperacaoMiB" @bind:after="MarcarPersonalizado" />
                                    </label>
                                }
                            }
                        </div>

                        <h3 class="grupo-titulo">Imagem do Windows</h3>
                        <div class="lista">
                            <label class="campo">
                                <span class="campo-titulo">Qual Windows instalar</span>
                                <span class="campo-descricao">Pela edição, usa a escolhida em Instalação. Se lá estiver em perguntar, a instalação pergunta aqui também.</span>
                                <select @bind="estado.Origem" @bind:after="MarcarPersonalizado">
                                    <option value="@OrigemImagem.Edicao">Pela edição (@NomeEdicao)</option>
                                    <option value="@OrigemImagem.Perguntar">Perguntar na hora</option>
                                    <option value="@OrigemImagem.Indice">Pelo número da imagem</option>
                                    <option value="@OrigemImagem.Nome">Pelo nome da imagem</option>
                                </select>
                            </label>
                            @if (estado.Origem == OrigemImagem.Indice)
                            {
                                <label class="campo">
                                    <span class="campo-titulo">Número da imagem</span>
                                    <span class="campo-descricao">Muda de uma ISO para outra.</span>
                                    <input type="number" min="1" @bind="estado.ImagemIndice" @bind:after="MarcarPersonalizado" />
                                </label>
                            }
                            else if (estado.Origem == OrigemImagem.Nome)
                            {
                                <label class="campo">
                                    <span class="campo-titulo">Nome da imagem</span>
                                    <span class="campo-descricao">Por exemplo, Windows 11 Pro.</span>
                                    <input type="text" spellcheck="false" @bind="estado.ImagemNome" @bind:after="MarcarPersonalizado" />
                                </label>
                            }
                            <label class="campo">
                                <span class="campo-titulo">Arquivo de paginação</span>
                                <span class="campo-descricao">Automático é o melhor para quase todo mundo.</span>
                                <select @bind="estado.Paginacao" @bind:after="MarcarPersonalizado">
                                    <option value="@ArquivoPaginacao.Automatico">Automático</option>
                                    <option value="@ArquivoPaginacao.Personalizado">Tamanho personalizado</option>
                                    <option value="@ArquivoPaginacao.Nenhum">Sem arquivo de paginação</option>
                                </select>
                            </label>
                            @if (estado.Paginacao == ArquivoPaginacao.Personalizado)
                            {
                                <label class="campo">
                                    <span class="campo-titulo">Tamanho inicial (MiB)</span>
                                    <span class="campo-descricao">Espaço reservado desde o início.</span>
                                    <input type="number" min="0" @bind="estado.PaginacaoInicialMiB" @bind:after="MarcarPersonalizado" />
                                </label>
                                <label class="campo">
                                    <span class="campo-titulo">Tamanho máximo (MiB)</span>
                                    <span class="campo-descricao">Até onde ele pode crescer.</span>
                                    <input type="number" min="0" @bind="estado.PaginacaoMaximaMiB" @bind:after="MarcarPersonalizado" />
                                </label>
                            }
                            else if (estado.Paginacao == ArquivoPaginacao.Nenhum)
                            {
                                <p class="alerta atencao">Sem paginação, alguns programas e jogos podem fechar quando a memória acabar.</p>
                            }
                        </div>

                        <h3 class="grupo-titulo">Execução</h3>
                        <div class="lista">
                            @ListaOpcoesScript(Categoria.Disco)
                        </div>
                    }
                    break;

                case Categoria.Seguranca:
                    <div class="lista">
                        @ListaOpcoesScript(Categoria.Seguranca)
                        @ListaOpcoes(Categoria.Seguranca)
                    </div>
                    break;

                case Categoria.Conta:
                    <p class="secao-sub">Como a conta é criada e o que aparece na configuração inicial.</p>
                    <div class="lista">
                        <label class="campo">
                            <span class="campo-titulo">Tipo de conta</span>
                            <span class="campo-descricao">A conta local é criada na hora, sem pedir email.</span>
                            <select @bind="estado.Conta">
                                <option value="@TipoConta.Local">Conta local</option>
                                <option value="@TipoConta.Microsoft">Conta Microsoft</option>
                            </select>
                        </label>
                        <label class="opcao @(estado.MostrarTelaWifi ? "ligada" : "")">
                            <span class="opcao-titulo">Mostrar a tela de rede na configuração inicial</span>
                            <span class="opcao-descricao">Desligada, a tela é pulada e o Wi-Fi fica para depois do primeiro login.</span>
                            <input class="chave" type="checkbox" role="switch" @bind="estado.MostrarTelaWifi" />
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Configurações de privacidade</span>
                            <span class="campo-descricao">As opções que o Windows pergunta na configuração inicial.</span>
                            <select @bind="estado.Privacidade">
                                <option value="@ExpressSettingsMode.DisableAll">Desligar todas</option>
                                <option value="@ExpressSettingsMode.Interactive">Perguntar na instalação</option>
                                <option value="@ExpressSettingsMode.EnableAll">Ligar todas</option>
                            </select>
                        </label>
                        @ListaOpcoes(Categoria.Conta)
                    </div>
                    break;

                case Categoria.Apps:
                    <p class="secao-sub">Ligue o que você quer remover. Os apps com aviso costumam fazer falta.</p>
                    <div class="acoes-lista">
                        <button type="button" class="botao-mini" @onclick="MarcarAppsSemAviso">Marcar os sem aviso</button>
                        <button type="button" class="botao-mini" @onclick="LimparApps">Limpar</button>
                    </div>
                    @foreach (var grupo in Catalogo.GruposApps)
                    {
                        <h3 class="grupo-titulo">@grupo</h3>
                        <div class="lista">
                            @foreach (var app in Catalogo.Apps.Where(a => a.Grupo == grupo))
                            {
                                @LinhaApp(app)
                            }
                        </div>
                    }
                    break;

                case Categoria.Interface:
                    <p class="secao-sub">A aparência e o comportamento da barra de tarefas e do Explorador.</p>
                    <div class="lista">
                        <label class="campo">
                            <span class="campo-titulo">Busca na barra de tarefas</span>
                            <span class="campo-descricao">Como a pesquisa aparece na barra.</span>
                            <select @bind="estado.BuscaBarra">
                                <option value="@TaskbarSearchMode.Box">Caixa de pesquisa</option>
                                <option value="@TaskbarSearchMode.Label">Ícone com texto</option>
                                <option value="@TaskbarSearchMode.Icon">Só o ícone</option>
                                <option value="@TaskbarSearchMode.Hide">Esconder</option>
                            </select>
                        </label>
                        <label class="campo">
                            <span class="campo-titulo">Arquivos ocultos</span>
                            <span class="campo-descricao">O que o Explorador mostra. Mostrar os do sistema faz aparecer o desktop.ini.</span>
                            <select @bind="estado.ArquivosOcultos">
                                <option value="@HideModes.Hidden">Esconder</option>
                                <option value="@HideModes.HiddenSystem">Mostrar os ocultos, menos os do sistema</option>
                                <option value="@HideModes.None">Mostrar tudo</option>
                            </select>
                        </label>
                        @ListaOpcoes(Categoria.Interface)
                    </div>
                    break;

                default:
                    <div class="lista">
                        @ListaOpcoes(categoriaAtual)
                    </div>
                    break;
            }
        }
    </main>
</div>

<footer class="rodape">
    Motor baseado no <a href="https://github.com/cschneegans/unattend-generator" target="_blank" rel="noopener">unattend-generator</a>, de Christoph Schneegans, sob a licença MIT. O Vega não é afiliado à Microsoft.
</footer>

<div class="capsula">
    @if (estado.ApagaDisco)
    {
        <button type="button" class="capsula-perigo" title="Este XML pode apagar um disco. Veja em Disco e imagem." @onclick="() => SelecionarCategoria(Categoria.Disco)">Apaga o disco</button>
    }
    <span class="capsula-info">@TotalAlteracoes @(TotalAlteracoes == 1 ? "alteração" : "alterações")</span>
    <button type="button" class="secundario" @onclick="VerXml">Ver XML</button>
    <button type="button" class="principal" @onclick="Baixar">Baixar XML</button>
</div>

<dialog id="previa-xml" aria-labelledby="previa-titulo">
    <div class="dialogo-corpo">
        <div class="dialogo-topo">
            <h2 id="previa-titulo">autounattend.xml</h2>
            <button type="button" class="botao-mini" @onclick="Copiar">@(copiado ? "Copiado!" : "Copiar")</button>
            <button type="button" class="botao-mini" @onclick="FecharPrevia">Fechar</button>
        </div>
        <pre tabindex="0">@previa</pre>
    </div>
</dialog>

@code {
    private readonly EstadoVega estado = new();
    private UnattendGenerator? gerador;
    private Categoria categoriaAtual = Categoria.Instalacao;
    private string busca = "";
    private string? perfilAtivo = "padrao";
    private string temaAtual = "grafite";
    private string? erro;
    private string previa = "";
    private bool copiado;

    private UnattendGenerator Gerador => gerador ??= new UnattendGenerator();

    private bool Buscando => !string.IsNullOrWhiteSpace(busca);

    private int TotalAlteracoes => Enum.GetValues<Categoria>().Sum(ContarAlteracoes);

    private string NomeEdicao => string.IsNullOrEmpty(estado.Edicao)
        ? "perguntar"
        : Gerador.WindowsEditions[estado.Edicao].DisplayName;

    private void MarcarPersonalizado()
    {
        perfilAtivo = null;
        erro = null;
    }

    protected override async Task OnAfterRenderAsync(bool primeiraVez)
    {
        if (primeiraVez)
        {
            temaAtual = await JS.InvokeAsync<string>("vega.temaAtual");
            StateHasChanged();
        }
    }

    private bool Combina(string texto) => texto.Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase);

    private int ContarAlteracoes(Categoria categoria)
    {
        if (categoria == Categoria.Apps)
        {
            return estado.AppsRemovidos.Count;
        }
        var total = Catalogo.Opcoes.Count(o => o.Categoria == categoria && estado.OpcoesLigadas.Contains(o.Id));
        if (categoria == Categoria.Disco && estado.Modo != ModoInstalacao.TelaNormal)
        {
            total++;
        }
        if (categoria == Categoria.Seguranca && estado.Modo == ModoInstalacao.Script && estado.DesligarDefender)
        {
            total++;
        }
        return total;
    }

    private void AlternarOpcaoScript(OpcaoScript opcao, bool ligada)
    {
        opcao.Gravar(estado, ligada);
        MarcarPersonalizado();
    }

    private void SelecionarCategoria(Categoria categoria)
    {
        busca = "";
        categoriaAtual = categoria;
    }

    private void AplicarPerfil(Perfil perfil)
    {
        perfil.Aplicar(estado);
        perfilAtivo = perfil.Id;
        erro = null;
    }

    private void AlternarOpcao(Opcao opcao, bool ligada)
    {
        if (ligada) estado.OpcoesLigadas.Add(opcao.Id); else estado.OpcoesLigadas.Remove(opcao.Id);
        MarcarPersonalizado();
    }

    private void AlternarApp(ItemRemovivel app, bool remover)
    {
        if (remover) estado.AppsRemovidos.Add(app.Id); else estado.AppsRemovidos.Remove(app.Id);
        MarcarPersonalizado();
    }

    private void MarcarAppsSemAviso()
    {
        estado.AppsRemovidos.UnionWith(Catalogo.Apps.Where(a => a.Aviso == Aviso.Nenhum).Select(a => a.Id));
        MarcarPersonalizado();
    }

    private void LimparApps()
    {
        estado.AppsRemovidos.Clear();
        MarcarPersonalizado();
    }

    private async Task AlternarTema() => temaAtual = await JS.InvokeAsync<string>("vega.alternarTema");

    private byte[]? Gerar()
    {
        try
        {
            erro = null;
            return estado.GerarXml(Gerador);
        }
        catch (ConfigurationException falha)
        {
            erro = $"Essa combinação não pode ser gerada: {falha.Message}";
        }
        catch (Exception falha)
        {
            erro = $"Não foi possível gerar o arquivo: {falha.Message}";
        }
        return null;
    }

    private async Task Baixar()
    {
        if (Gerar() is { } bytes)
        {
            await JS.InvokeVoidAsync("vega.baixar", "autounattend.xml", bytes);
        }
    }

    private async Task VerXml()
    {
        if (Gerar() is { } bytes)
        {
            previa = Encoding.ASCII.GetString(bytes);
            copiado = false;
            await JS.InvokeVoidAsync("vega.abrirDialogo", "previa-xml");
        }
    }

    private async Task FecharPrevia() => await JS.InvokeVoidAsync("vega.fecharDialogo", "previa-xml");

    private async Task Copiar() => copiado = await JS.InvokeAsync<bool>("vega.copiar", previa);

    private static string ClasseAviso(Aviso aviso) => aviso switch
    {
        Aviso.Risco => "risco",
        Aviso.Atencao => "atencao",
        _ => "",
    };

    private RenderFragment ListaOpcoes(Categoria categoria) => __builder =>
    {
        foreach (var opcao in Catalogo.Opcoes.Where(o => o.Categoria == categoria))
        {
            @LinhaOpcao(opcao)
        }
    };

    private RenderFragment LinhaOpcao(Opcao opcao) => __builder =>
    {
        var ligada = estado.OpcoesLigadas.Contains(opcao.Id);
        <label class="opcao @(ligada ? "ligada" : "")" @key="opcao.Id">
            <span class="opcao-titulo">@opcao.Titulo</span>
            <span class="opcao-descricao">@opcao.Descricao</span>
            @if (opcao.Custo is not null)
            {
                <span class="opcao-custo @ClasseAviso(opcao.Aviso)">@opcao.Custo</span>
            }
            <input class="chave" type="checkbox" role="switch" checked="@ligada" @onchange="e => AlternarOpcao(opcao, e.Value is true)" />
        </label>
    };

    private RenderFragment ListaOpcoesScript(Categoria categoria) => __builder =>
    {
        foreach (var opcao in Catalogo.OpcoesScript.Where(o => o.Categoria == categoria))
        {
            @LinhaOpcaoScript(opcao)
        }
    };

    private RenderFragment LinhaOpcaoScript(OpcaoScript opcao) => __builder =>
    {
        var disponivel = estado.Modo == ModoInstalacao.Script;
        var ligada = disponivel && opcao.Ler(estado);
        <label class="opcao @(ligada ? "ligada" : "") @(disponivel ? "" : "desativada")" @key="opcao.Id">
            <span class="opcao-titulo">@opcao.Titulo</span>
            <span class="opcao-descricao">@opcao.Descricao</span>
            @if (!disponivel)
            {
                <span class="opcao-custo">Só funciona no modo script. <button type="button" class="link" @onclick="() => SelecionarCategoria(Categoria.Disco)" @onclick:preventDefault="true">Ver em Disco e imagem</button></span>
            }
            else if (opcao.Custo is not null)
            {
                <span class="opcao-custo @ClasseAviso(opcao.Aviso)">@opcao.Custo</span>
            }
            <input class="chave" type="checkbox" role="switch" disabled="@(!disponivel)" checked="@ligada" @onchange="e => AlternarOpcaoScript(opcao, e.Value is true)" />
        </label>
    };

    private RenderFragment LinhaApp(ItemRemovivel app) => __builder =>
    {
        var remover = estado.AppsRemovidos.Contains(app.Id);
        <label class="opcao @(remover ? "ligada" : "")" @key="app.Id">
            <span class="opcao-titulo">@app.Nome</span>
            @if (app.Custo is not null)
            {
                <span class="opcao-custo @ClasseAviso(app.Aviso)">@app.Custo</span>
            }
            <input class="chave" type="checkbox" role="switch" aria-label="Remover @app.Nome" checked="@remover" @onchange="e => AlternarApp(app, e.Value is true)" />
        </label>
    };
}
