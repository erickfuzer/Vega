<label class="opcao @(Valor && !Desativado ? "ligada" : "") @(Desativado ? "desativada" : "")">
    <span class="opcao-titulo">@Titulo</span>
    @if (Descricao is not null)
    {
        <span class="opcao-descricao">@Descricao</span>
    }
    @if (Custo is not null)
    {
        <span class="opcao-custo @Classe">@Custo</span>
    }
    <input class="chave" type="checkbox" role="switch" disabled="@Desativado" checked="@Valor" @onchange="Alterar" />
</label>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = "";
    [Parameter] public string? Descricao { get; set; }
    [Parameter] public string? Custo { get; set; }
    [Parameter] public Aviso Aviso { get; set; }
    [Parameter] public bool Desativado { get; set; }
    [Parameter] public bool Valor { get; set; }
    [Parameter] public EventCallback<bool> ValorChanged { get; set; }

    private string Classe => Aviso switch
    {
        Aviso.Risco => "risco",
        Aviso.Atencao => "atencao",
        _ => "",
    };

    private Task Alterar(ChangeEventArgs e) => ValorChanged.InvokeAsync(e.Value is true);
}
